# Copia este archivo a core/.env.test (está en .gitignore) y ajusta los valores.
# Los tests de integración (core/test/**) hacen dropSchema/synchronize:
# usa SIEMPRE una base de datos local y desechable cuyo nombre termine en _test.
NODE_ENV=test
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=realestate_test

JWT_SECRET=test-only-change-me

PORTAL_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3002
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001

# Correo: en NODE_ENV=test se usa transporte de prueba; deja valores ficticios.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=test
MAIL_PASS=test
MAIL_FROM=test@example.com

# Almacenamiento local en tests (nunca R2/S3 reales)
STORAGE_PROVIDER=local
STORAGE_STRATEGY=local

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.com
