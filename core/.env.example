# Core API (NestJS) — merge into core/.env

NODE_ENV=development
PORT=8000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=real_estate_platform

JWT_SECRET=change-me
PORTAL_URL=http://localhost:8001
BACKOFFICE_URL=http://localhost:8002
# Alias kept for older docs; portal links prefer PORTAL_URL
FRONTEND_PUBLIC_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# Mail
# Dev (Mailpit): npm run mail:dev — SMTP :1025, UI http://localhost:8025
# Prod/staging (Resend SMTP): set MAIL_HOST=smtp.resend.com, MAIL_USER=resend,
#   MAIL_PASS=<Resend API key>, MAIL_FROM=<verified domain address>
# Do not commit real API keys. The key goes in MAIL_PASS (no RESEND_API var).
# ---------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=contacto@bravoshottpropiedades.cl

# Storage (local | r2 | s3). Alias: STORAGE_STRATEGY=cloudflare → r2
STORAGE_PROVIDER=r2
STORAGE_STRATEGY=cloudflare
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=civika
R2_PUBLIC_URL=
# seed:reset empties the R2 bucket before uploading samples (dev buckets only)
SEED_WIPE_BUCKET=true
# Comma-separated allowlist. Refuse wipe if R2_BUCKET_NAME is not listed.
SEED_WIPE_ALLOWED_BUCKETS=civika,bshop
