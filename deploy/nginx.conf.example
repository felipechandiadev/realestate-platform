# Ejemplo nginx — completar placeholders antes de usar en producción.
# Dominios de referencia ya usados en deploy/nginx/bravoshottpropiedades.cl.conf:
#   portal:     YOUR_PORTAL_DOMAIN
#   backoffice: YOUR_ADMIN_DOMAIN
#   core API:   YOUR_CORE_DOMAIN
#
# Importante para rate-limit / auth: reenviar IP real del cliente
# (X-Real-IP / X-Forwarded-For). Sin eso, limit_req ve solo 127.0.0.1.

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Shared security headers (include from each server or paste)
# add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
# add_header X-Content-Type-Options "nosniff" always;
# add_header X-Frame-Options "SAMEORIGIN" always;
# add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

# --- Portal ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_PORTAL_DOMAIN;

    # ssl_certificate     /etc/letsencrypt/live/YOUR_PORTAL_DOMAIN/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/YOUR_PORTAL_DOMAIN/privkey.pem;

    client_max_body_size 100m;  # = bodySizeLimit de Next; un envío puede llevar video (70MB) + fotos

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# --- Backoffice ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_ADMIN_DOMAIN;

    client_max_body_size 100m;  # = bodySizeLimit de Next; un envío puede llevar video (70MB) + fotos

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# --- Core API ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_CORE_DOMAIN;

    client_max_body_size 100m;  # = bodySizeLimit de Next; un envío puede llevar video (70MB) + fotos

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Throttle auth endpoints (ajusta rate en limit_req_zone arriba).
    # Requiere X-Real-IP / X-Forwarded-For correctos desde este proxy.
    location /auth {
        limit_req zone=auth_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_buffering off;
    }
}

# HTTP → HTTPS (placeholders)
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_PORTAL_DOMAIN YOUR_ADMIN_DOMAIN YOUR_CORE_DOMAIN;
    return 301 https://$host$request_uri;
}
