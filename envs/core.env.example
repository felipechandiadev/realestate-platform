# Core API (NestJS) — copia a core/.env y completa los valores.
# Este archivo y core/.env.example deben ser idénticos (lo comprueba un test).
# Nunca subas valores reales (claves, contraseñas) al repositorio.

NODE_ENV=development
PORT=8000

# ---------------------------------------------------------------------------
# Base de datos (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=real_estate_platform
# Solo los scripts de seed leen DB_SSL / DB_SSL_MODE / DB_SSL_CA_PATH (BD remota con TLS).
# DB_SSL=true
# DB_SSL_MODE=REQUIRED
# DB_SSL_CA_PATH=

# Esquema / migraciones (ver core/database/BASELINE.md)
# DB_SYNCHRONIZE: solo development/test; en production la app no arranca si vale true.
DB_SYNCHRONIZE=
# CONFIRM_MIGRATION=yes: pásalo solo en la línea de migration:run/revert/generate
# contra producción o un host no local. No lo dejes fijo aquí.

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# URL pública de esta API (se usa para armar URLs de archivos locales y fotos de perfil).
# Producción: https://core.bravoshottpropiedades.cl
BACKEND_PUBLIC_URL=http://localhost:8000
PORTAL_URL=http://localhost:8001
BACKOFFICE_URL=http://localhost:8002
# Alias antiguo; los enlaces del portal usan PORTAL_URL
FRONTEND_PUBLIC_URL=http://localhost:8001
# Orígenes CORS permitidos (coma). Si se omite: dominios de producción +
# PORTAL_URL/BACKOFFICE_URL. Los localhost solo se aceptan fuera de producción.
# Producción: CORS_ORIGINS=https://bravoshottpropiedades.cl,https://www.bravoshottpropiedades.cl,https://admin.bravoshottpropiedades.cl
CORS_ORIGINS=
# IPs exentas del rate limiting (coma). Por defecto solo loopback (portal y
# backoffice llaman a core desde el mismo servidor). Si BACKEND_API_URL apunta
# al dominio público, agrega aquí la IP pública del servidor.
# THROTTLE_SKIP_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ---------------------------------------------------------------------------
# Autenticación (obligatorio: sin claves JWE el login no funciona)
# Opción A (servidor): claves PEM en base64 en las variables.
# Opción B (local): rutas a los archivos PEM (por defecto keys/private.pem y keys/public.pem).
# ---------------------------------------------------------------------------
JWT_SECRET=change-me
JWE_PRIVATE_KEY=
JWE_PUBLIC_KEY=
# JWE_PRIVATE_KEY_PATH=keys/private.pem
# JWE_PUBLIC_KEY_PATH=keys/public.pem
# Vigencia del enlace de recuperación de contraseña, en minutos (por defecto 30)
# PASSWORD_RESET_TOKEN_TTL=

# Web Push (genera una vez con `npx web-push generate-vapid-keys`; la privada es secreta)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravoshottpropiedades.cl

# ---------------------------------------------------------------------------
# Correo
# Desarrollo (Mailpit): npm run mail:dev — SMTP :1025, UI http://localhost:8025
# Producción (Resend por SMTP):
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587          ← usar 587 (STARTTLS). 465 NO funciona: la conexión usa secure=false.
#   MAIL_USER=resend
#   MAIL_PASS=<API key de Resend>   (no existe variable RESEND_API_KEY)
#   MAIL_FROM=<dirección de un dominio verificado en Resend, con SPF y DKIM en el DNS>
# Plan gratuito de Resend: ~100 correos/día y 3.000/mes.
# ---------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=contacto@bravoshottpropiedades.cl

# ---------------------------------------------------------------------------
# Almacenamiento de archivos (local | r2 | s3). Alias: STORAGE_STRATEGY=cloudflare → r2
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_STRATEGY=cloudflare
# Cloudflare R2: ID de cuenta y un token de API R2 con permiso de lectura/escritura sobre el bucket.
R2_ACCOUNT_ID=
# Opcional; por defecto https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública del bucket, sin barra final. Debe ser la misma en portal y backoffice.
# Producción: un dominio propio conectado al bucket (p. ej. https://media.bravoshottpropiedades.cl).
# El subdominio pub-xxxx.r2.dev tiene límite de tráfico y Cloudflare no lo recomienda en producción.
R2_PUBLIC_URL=
# Solo con STORAGE_PROVIDER=local
# UPLOAD_BASE_PATH=public
# UPLOAD_MAX_FILE_SIZE=
# Solo con STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=
# S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Seed (solo desarrollo)
# SEED_WIPE_BUCKET=true hace que seed:reset VACÍE el bucket antes de subir ejemplos.
# Solo se permite si R2_BUCKET_NAME está en SEED_WIPE_ALLOWED_BUCKETS.
# Nunca pongas aquí el bucket de producción.
# ---------------------------------------------------------------------------
SEED_WIPE_BUCKET=false
SEED_WIPE_ALLOWED_BUCKETS=
