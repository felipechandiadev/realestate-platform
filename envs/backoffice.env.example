# Backoffice (Next.js) — copia a backoffice/.env.local (desarrollo) o backoffice/.env (servidor).
# Este archivo y backoffice/.env.example deben ser idénticos (lo comprueba un test).

PORT=8002

# NextAuth: NEXTAUTH_URL = URL pública del backoffice; NEXTAUTH_SECRET = secreto largo y aleatorio.
NEXTAUTH_URL=http://localhost:8002
NEXTAUTH_SECRET=change-me-in-dev

# API core (en el servidor, preferir la dirección interna http://127.0.0.1:8000)
AUTH_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:8000/public

# URL pública del portal (enlaces "ver en el portal")
NEXT_PUBLIC_PORTAL_URL=http://localhost:8001

# Misma URL pública de R2 que en core (R2_PUBLIC_URL). Autoriza ese dominio para las imágenes.
R2_PUBLIC_URL=

# Versión y fecha que muestra "Acerca de" (opcional; conviene fijarlas en cada despliegue)
# NEXT_PUBLIC_APP_NAME=
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_APP_RELEASE=
