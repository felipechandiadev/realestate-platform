# Portal (Next.js) — copia a portal/.env.local (desarrollo) o portal/.env (servidor).
# Este archivo y portal/.env.example deben ser idénticos (lo comprueba un test).

PORT=8001

# URL pública del portal, sin barra final. Define las URL de robots.txt, sitemap.xml,
# canonical y Open Graph. En producción es obligatoria: https://bravoshottpropiedades.cl
NEXT_PUBLIC_PORTAL_URL=http://localhost:8001
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:8002

# NextAuth: NEXTAUTH_URL = URL pública del portal; NEXTAUTH_SECRET = secreto largo y aleatorio
# (distinto en cada entorno; genera uno con `openssl rand -base64 32`).
NEXTAUTH_URL=http://localhost:8001
NEXTAUTH_SECRET=change-me-in-dev

# API core. En el servidor conviene la dirección interna (http://127.0.0.1:8000) para
# que el límite de intentos reconozca al portal (ver THROTTLE_SKIP_IPS en core).
AUTH_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:8000/public

# Misma URL pública de R2 que en core (R2_PUBLIC_URL). Autoriza ese dominio para las imágenes.
R2_PUBLIC_URL=
